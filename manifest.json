{
  "manifest_version": 3,
  "name": "Tab Organizer",
  "version": "1.3.0",
  "description": "Gruppiert Tabs nach Themen aus Seitentiteln und verwaltet Such-, Storage- und Duplikat-Tabs.",
  "permissions": ["tabs", "tabGroups"],
  "optional_permissions": ["scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Tab Organizer",
    "default_popup": "popup.html"
  }
}
